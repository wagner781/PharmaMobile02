CREATE TABLE producto (
    id INTEGER NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    precio REAL NOT NULL,
    stock INTEGER NOT NULL,
    pendiente INTEGER NOT NULL DEFAULT 0,
    intentos INTEGER NOT NULL DEFAULT 0,
    ultimoError TEXT
);

listarTodos:
SELECT * FROM producto ORDER BY nombre ASC;

listarPendientes:
SELECT * FROM producto WHERE pendiente = 1;

pendientesPorEnviar:
SELECT * FROM producto
WHERE pendiente = 1 AND intentos < :maxIntentos
ORDER BY id;

contarPendientes:
SELECT COUNT(*) FROM producto WHERE pendiente = 1 AND intentos < :maxIntentos;

contarFallidas:
SELECT COUNT(*) FROM producto WHERE pendiente = 1 AND intentos >= :maxIntentos;

sumarIntento:
UPDATE producto SET intentos = intentos + 1, ultimoError = :ultimoError
WHERE id = :id AND pendiente = 1;

insertar:
INSERT OR REPLACE INTO producto (id, nombre, precio, stock, pendiente)
VALUES (?, ?, ?, ?, ?);

borrarSincronizados:
DELETE FROM producto WHERE pendiente = 0;

siguienteIdLocal:
-- COALESCE evita el NULL de la tabla vacia; el minOf de Kotlin
-- garantiza que el id resultante sea siempre negativo.
SELECT COALESCE(MIN(id), 0) FROM producto;

borrarPorId:
DELETE FROM producto WHERE id = ?;

borrarTodos:
DELETE FROM producto;
